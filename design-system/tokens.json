{
  "color-bg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
    "$description": "Default page and surface background."
  },
  "color-bg-subtle": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.973, 0.98, 0.988], "hex": "#f8fafc" },
    "$description": "Sidebar, table header and zebra-row background."
  },
  "color-bg-inset": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.945, 0.961, 0.976], "hex": "#f1f5f9" },
    "$description": "Recessed surfaces: input backgrounds, code blocks, neutral chip fill."
  },
  "color-fg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.118, 0.161, 0.231], "hex": "#1e293b" },
    "$description": "Primary body text. Meets WCAG AA (4.5:1) on color-bg."
  },
  "color-fg-muted": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.392, 0.455, 0.545], "hex": "#64748b" },
    "$description": "Secondary text: hints, captions, table metadata."
  },
  "color-fg-inverse": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
    "$description": "Text/icon color on filled, high-emphasis surfaces (primary/danger buttons)."
  },
  "color-primary": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.145, 0.388, 0.922], "hex": "#2563eb" },
    "$description": "Primary brand/action color for the app."
  },
  "color-primary-hover": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.114, 0.306, 0.847], "hex": "#1d4ed8" },
    "$description": "Hover/active state for primary-colored controls."
  },
  "color-primary-subtle": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.863, 0.918, 0.996], "hex": "#dbeafe" },
    "$description": "Low-emphasis primary fill: selected nav item, info badge/alert background."
  },
  "color-border": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.886, 0.91, 0.941], "hex": "#e2e8f0" },
    "$description": "Default hairline border for cards, tables, dividers."
  },
  "color-border-strong": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.796, 0.835, 0.882], "hex": "#cbd5e1" },
    "$description": "Emphasized border: input outlines, secondary button border."
  },
  "color-success": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.086, 0.639, 0.29], "hex": "#16a34a" },
    "$description": "Success state: approved records, completed tasks."
  },
  "color-success-subtle": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.863, 0.988, 0.906], "hex": "#dcfce7" },
    "$description": "Success badge/alert background."
  },
  "color-warning": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.851, 0.467, 0.024], "hex": "#d97706" },
    "$description": "Warning state: pending review, approaching deadline."
  },
  "color-warning-subtle": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.996, 0.953, 0.78], "hex": "#fef3c7" },
    "$description": "Warning badge/alert background."
  },
  "color-danger": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.863, 0.149, 0.149], "hex": "#dc2626" },
    "$description": "Destructive actions and error states."
  },
  "color-danger-subtle": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.996, 0.894, 0.894], "hex": "#fee2e2" },
    "$description": "Danger badge/alert background."
  },
  "color-overlay": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.059, 0.09, 0.165], "alpha": 0.5, "hex": "#0f172a" },
    "$description": "Modal/drawer backdrop scrim."
  },
  "space-1": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Tightest spacing: icon-to-label gaps, chip padding."
  },
  "space-2": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" },
    "$description": "Compact spacing: form control internal padding, stack gaps within a field."
  },
  "space-3": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" },
    "$description": "Default spacing: table cell padding, button padding."
  },
  "space-4": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" },
    "$description": "Component spacing: card padding, gap between fields."
  },
  "space-5": {
    "$type": "dimension",
    "$value": { "value": 24, "unit": "px" },
    "$description": "Section spacing: gap between cards, page section padding."
  },
  "space-6": {
    "$type": "dimension",
    "$value": { "value": 32, "unit": "px" },
    "$description": "Layout spacing: page gutters on desktop."
  },
  "radius-sm": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Chips, badges, small controls."
  },
  "radius-md": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" },
    "$description": "Default corner radius: buttons, inputs, cards."
  },
  "radius-lg": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" },
    "$description": "Overlays: modals, drawers, dropdown menus."
  },
  "radius-full": {
    "$type": "dimension",
    "$value": { "value": 9999, "unit": "px" },
    "$description": "Fully-rounded controls: avatars, switches, pill chips."
  },
  "font-size-xs": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" },
    "$description": "Captions, badge labels, table meta text."
  },
  "font-size-sm": {
    "$type": "dimension",
    "$value": { "value": 13, "unit": "px" },
    "$description": "Dense UI text: table cells, form labels, secondary buttons."
  },
  "font-size-md": {
    "$type": "dimension",
    "$value": { "value": 15, "unit": "px" },
    "$description": "Default body text."
  },
  "font-size-lg": {
    "$type": "dimension",
    "$value": { "value": 20, "unit": "px" },
    "$description": "Section and card headings."
  },
  "font-size-xl": {
    "$type": "dimension",
    "$value": { "value": 24, "unit": "px" },
    "$description": "Page titles."
  },
  "font-family-sans": {
    "$type": "fontFamily",
    "$value": "Inter, system-ui, -apple-system, sans-serif",
    "$description": "Default UI typeface for all text."
  },
  "font-family-mono": {
    "$type": "fontFamily",
    "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace",
    "$description": "Record IDs, codes, audit log timestamps."
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400,
    "$description": "Body text."
  },
  "font-weight-medium": {
    "$type": "fontWeight",
    "$value": 500,
    "$description": "Labels, button text, table headers."
  },
  "font-weight-semibold": {
    "$type": "fontWeight",
    "$value": 600,
    "$description": "Headings, emphasized values."
  },
  "shadow-sm": {
    "$type": "shadow",
    "$value": {
      "color": { "colorSpace": "srgb", "components": [0.059, 0.09, 0.165], "alpha": 0.08, "hex": "#0f172a" },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 1, "unit": "px" },
      "blur": { "value": 2, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    },
    "$description": "Resting elevation: cards, dropdown triggers."
  },
  "shadow-md": {
    "$type": "shadow",
    "$value": {
      "color": { "colorSpace": "srgb", "components": [0.059, 0.09, 0.165], "alpha": 0.16, "hex": "#0f172a" },
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 8, "unit": "px" },
      "blur": { "value": 24, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    },
    "$description": "Floating elevation: dropdown menus, modals, toasts."
  },
  "button-primary-background": {
    "$type": "color",
    "$value": "{color-primary}",
    "$description": "Primary button fill."
  },
  "button-primary-background-hover": {
    "$type": "color",
    "$value": "{color-primary-hover}",
    "$description": "Primary button hover/active fill."
  },
  "button-primary-foreground": {
    "$type": "color",
    "$value": "{color-fg-inverse}",
    "$description": "Primary button label/icon color."
  },
  "button-secondary-background": {
    "$type": "color",
    "$value": "{color-bg}",
    "$description": "Secondary button fill."
  },
  "button-secondary-border": {
    "$type": "color",
    "$value": "{color-border-strong}",
    "$description": "Secondary button outline."
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$value": "{color-fg}",
    "$description": "Secondary button label color."
  },
  "button-ghost-foreground": {
    "$type": "color",
    "$value": "{color-fg}",
    "$description": "Ghost button label color."
  },
  "button-danger-background": {
    "$type": "color",
    "$value": "{color-danger}",
    "$description": "Destructive button fill."
  },
  "button-danger-foreground": {
    "$type": "color",
    "$value": "{color-fg-inverse}",
    "$description": "Destructive button label color."
  },
  "card-default-background": {
    "$type": "color",
    "$value": "{color-bg}",
    "$description": "Card surface fill."
  },
  "card-default-border": {
    "$type": "color",
    "$value": "{color-border}",
    "$description": "Card outline."
  },
  "card-default-radius": {
    "$type": "dimension",
    "$value": "{radius-md}",
    "$description": "Card corner radius."
  },
  "card-default-padding": {
    "$type": "dimension",
    "$value": "{space-4}",
    "$description": "Card internal padding."
  },
  "input-default-background": {
    "$type": "color",
    "$value": "{color-bg}",
    "$description": "Form control fill."
  },
  "input-default-border": {
    "$type": "color",
    "$value": "{color-border-strong}",
    "$description": "Form control outline."
  },
  "input-default-foreground": {
    "$type": "color",
    "$value": "{color-fg}",
    "$description": "Form control text color."
  },
  "input-invalid-border": {
    "$type": "color",
    "$value": "{color-danger}",
    "$description": "Form control outline when validation fails."
  },
  "badge-neutral-background": {
    "$type": "color",
    "$value": "{color-bg-inset}",
    "$description": "Neutral badge/chip fill."
  },
  "badge-neutral-foreground": {
    "$type": "color",
    "$value": "{color-fg-muted}",
    "$description": "Neutral badge/chip text."
  }
}
